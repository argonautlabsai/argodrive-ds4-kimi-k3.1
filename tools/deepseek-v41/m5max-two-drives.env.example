# DeepSeek V4.1 Flash on a MacBook Pro M5 Max, model on the internal SSD with a byte-identical copy on one
# Thunderbolt 5 NVMe drive. Measured 12 November 2026 with --ssd-streaming-cache-experts 4368 (see README.md; the
# DS4_ARGODRIVE_COOC and DS4_ARGODRIVE_DECODE_PIPELINE lines were added after the main table was measured).
# Replace the two paths. For one drive, delete the PRIMARY_WEIGHT and REPLICAS lines. For a third drive:
#   DS4_ARGODRIVE_PRIMARY_WEIGHT=14
#   DS4_ARGODRIVE_REPLICAS=/Volumes/SecondDrive/<model>.gguf*6,/Volumes/ThirdDrive/<model>.gguf*7
# (the third may be an experts-only copy written by make_replica.py)
DS4_ARGODRIVE_PRIMARY_NOCACHE=1
DS4_ARGODRIVE_PRIMARY_WEIGHT=7
DS4_ARGODRIVE_REPLICAS=/Volumes/SecondDrive/DeepSeek-V4.1-Flash-1017-MXFP4-experts.gguf*3
DS4_ARGODRIVE_PREFILL_SPLIT=1
DS4_ARGODRIVE_PREFILL_SELECTIVE=1
DS4_ARGODRIVE_PREFILL_SELECTIVE_MAX=2048
DS4_ARGODRIVE_PREFILL_AHEAD=1
DS4_ARGODRIVE_PREFILL_LANES=8
DS4_ARGODRIVE_PREFILL_HOT=384
DS4_ARGODRIVE_HOTLIST=/path/to/repo/tools/deepseek-v41/hotlists/deepseek-v4.1-flash-1017-readahead.txt
DS4_ARGODRIVE_COOC=/path/to/repo/tools/deepseek-v41/hotlists/deepseek-v4.1-flash-1017-cooc.bin
DS4_ARGODRIVE_PREFILL_CACHE_COPY=1
DS4_ARGODRIVE_CACHE_SHARE=1
DS4_ARGODRIVE_ENGRAM_PREFETCH_MIN=1
DS4_ARGODRIVE_ENGRAM_BATCH_READERS=128
DS4_ARGODRIVE_GAP_KEEPALIVE=2
DS4_TP_KEEPALIVE_TGS=1
DS4_TP_KEEPALIVE_ITERS=300000
DS4_ARGODRIVE_DECODE_PIPELINE=4
